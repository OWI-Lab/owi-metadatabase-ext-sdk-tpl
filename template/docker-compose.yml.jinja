{% if include_docker %}
services:
  db:
    build:
      context: ./docker/postgres
    environment:
      POSTGRES_DB: {{ project_slug }}_db
      POSTGRES_USER: {{ project_slug }}_user
      POSTGRES_PASSWORD: testpassword
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./tests/data:/data:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_slug }}_user -d {{ project_slug }}_db"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  postgres_data:
{% endif %}
